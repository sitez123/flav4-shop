# FLAV4 server settings — copy to .env and fill in
PORT=3000
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too

# Mailbox the shop sends from (any normal email account with SMTP, e.g. Hostinger / Google Workspace)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@yourdomain.com
SMTP_PASS=
FROM_EMAIL=orders@yourdomain.com
# Where new-order emails go (can also be changed in admin → Settings)
OWNER_EMAIL=you@yourdomain.com

# Optional: new orders also ping Telegram (can also be set in admin → Settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
